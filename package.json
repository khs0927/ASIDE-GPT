{
  "name": "aside-gpt",
  "version": "0.4.0",
  "private": true,
  "description": "Local-first Aside orchestrator with a Gemini Web bridge, durable task runtime, and future Aside Remote boundary.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check:skills": "npm run build && node dist/scripts/validate-skills.js",
    "ci": "npm run typecheck && npm test && npm run check:skills",
    "test:browser": "node --import tsx --test tests/browser/*.test.ts",
    "cli": "node dist/packages/gemini-bridge/cli.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "playwright-core": "1.56.1",
    "xstate": "5.32.6",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "bin": {
    "aside-gpt": "dist/packages/gemini-bridge/cli.js"
  }
}
