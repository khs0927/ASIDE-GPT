{
  "name": "aside-gpt",
  "version": "0.2.0",
  "private": true,
  "description": "Mobile-only ChatGPT Work skills and browser-task policies.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:skills": "node --import tsx scripts/validate-skills.ts",
    "ci": "npm run typecheck && npm test && npm run check:skills && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
